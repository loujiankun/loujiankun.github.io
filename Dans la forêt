<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-IMG_2128.JPEG">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jiankun Lou | Dans la forêt</title>
    <link rel="stylesheet" href="style.css">
    <style>
        /* --- 图片网格布局 --- */
        .image-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr); /* 每行三列 */
            gap: 40px 20px; /* 上下间距40px，左右间距20px */
            max-width: 1000px;
            margin: 0 auto 50px auto;
            
            /* 核心：让同一行的内容垂直居中对齐（中心线对齐） */
            align-items: center; 
        }

        .work-item {
            text-align: center;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        /* 移除图片固定高度，改用 max-height 保证不裁剪且中心对齐 */
        .gallery-img {
            width: 100%;
            max-height: 250px; /* 限制最高高度 */
            object-fit: contain; /* 保证图片比例完整，不被裁剪 */
            transition: opacity 0.3s ease;
            display: block;
            margin: 0 auto;
        }

        .work-item a {
            text-decoration: none;
            color: inherit;
            display: block;
        }

        .work-item a:hover .gallery-img {
            opacity: 0.7;
        }

        /* --- 文字内容排版 --- */
        .project-info {
            max-width: 700px;
            margin: 60px auto;
            text-align: center;
        }

        .project-title {
            font-weight: 300;
            letter-spacing: 3px;
            margin-bottom: 25px;
            text-transform: uppercase;
        }

        .description-text {
            font-size: 0.85rem;
            line-height: 1.8;
            color: #444;
            text-align: justify;
        }

        .caption-link {
            margin-top: 15px;
            font-size: 0.7rem;
            letter-spacing: 1px;
            color: #999;
            text-transform: uppercase;
            transition: color 0.3s;
        }
        
        .work-item a:hover .caption-link {
            color: #000;
        }
    </style>
</head>
<body>
    <div class="container">
        <aside class="sidebar">
