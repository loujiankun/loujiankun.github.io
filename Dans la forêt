                    <li><a href="index.html#about">ABOUT</a></li>
                </ul>
            </nav>
        </aside>

        <main class="content">
            <div style="margin-bottom: 40px;">
                <a href="index.html" style="font-size: 0.7rem; color: #999; text-decoration: none; letter-spacing: 1px;">← BACK TO ALL WORKS</a>
            </div>

            <div class="image-grid">
                <div class="work-item">
                    <a href="troncs.html">
                        <img src="B.jpg" class="gallery-img" alt="TRONCS">
                        <p class="caption-link">I. TRONC (2023) →</p>
                    </a>
                </div>

                <div class="work-item">
                    <a href="petioles.html">
                        <img src="R.jpg" class="gallery-img" alt="Petioles">
                        <p class="caption-link">II. PETIOLE (2023) →</p>
                    </a>
                </div>

                <div class="work-item">
                    <a href="tente.html">
                        <img src="P.jpg" class="gallery-img" alt="Tente">
                        <p class="caption-link">III. TENTE (2023) →</p>
                    </a>
                </div>

                <div class="work-item">
                    <a href="vagues et nuages.html">
                        <img src="Y.jpg" class="gallery-img" alt="Vagues et nuages">
                        <p class="caption-link">IV. VAGUES ET NUAGES (2025) →</p>
                    </a>
                </div>

                <div class="work-item">
                    <a href="reflet-eau.html">
                        <img src="X.jpg" class="gallery-img" alt="Reflet">
                        <p class="caption-link">V. REFLET D'EAU (2025) →</p>
                    </a>
                </div>
            </div>

            <hr style="border: 0; border-top: 1px solid #eee; width: 50px; margin: 40px auto;">

            <section class="project-info">
                <h2 class="project-title">Un Paysage Reconstruit</h2>
                <div class="description-text">
                    Cette série s'inspire de poèmes anciens décrivant les paysages et les vicissitudes de la nature. 
                    À travers le processus de dissolution de l'encre sur le papier de riz, les mots deviennent illisibles, 
                    symbolisant une transition de la forme tangible vers l'intangible.
                </div>
            </section>
        </main>
    </div>
    
    </body>
